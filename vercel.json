{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "services/alexa-mcp-server/public",
  "functions": {
    "api/index.js": {
      "includeFiles": "services/alexa-mcp-server/{dist,public}/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
